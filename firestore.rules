rules_version = '2';

/**
 * Sirbax — production Firestore security rules
 *
 * Paste into: Firebase Console → Firestore Database → Rules → Publish
 *
 * Principles:
 * - Public read for social content (posts, profiles, stories, listings)
 * - Writes only by signed-in users
 * - Own-data restrictions for deletes/sensitive updates
 * - Reaction doc ID MUST equal request.auth.uid (one reaction per account)
 * - Conversations only for participants
 * - Never expose reports list to clients
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isString(v) {
      return v is string;
    }

    function validNickname(n) {
      return isString(n) && n.size() >= 2 && n.size() <= 40;
    }

    // Users — public profiles; owner writes
    match /users/{userId} {
      allow read: if true;
      allow create: if isUser(userId)
        && request.resource.data.keys().hasAny(['nickname'])
        && validNickname(request.resource.data.nickname);
      allow update: if isUser(userId);
      allow delete: if isUser(userId);
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && isString(request.resource.data.authorNickname);

      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'likesCount',
              'commentsCount',
              'sharesCount',
              'reactions',
              'updatedAt'
            ])
      );

      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && (
            request.resource.data.keys().hasAny(['text'])
            || request.resource.data.keys().hasAny(['content'])
          );

        allow update: if signedIn() && (
          resource.data.authorId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likesCount'])
        );

        allow delete: if signedIn()
          && resource.data.authorId == request.auth.uid;
      }

      // One reaction per account — doc id must be uid
      match /reactions/{reactionUid} {
        allow read: if true;

        allow create: if signedIn()
          && reactionUid == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAny(['type']);

        allow update: if signedIn()
          && reactionUid == request.auth.uid
          && resource.data.userId == request.auth.uid;

        allow delete: if signedIn()
          && reactionUid == request.auth.uid;
      }
    }

    // Stories
    match /stories/{storyId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && isString(request.resource.data.mediaUrl);
      allow update, delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
    }

    // Follows — doc id {followerId}_{followingId}
    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
    }

    // DMs — participants only
    match /conversations/{cid} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;

      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds;

      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participantIds;

        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participantIds
          && isString(request.resource.data.text)
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow update: if false;

        allow delete: if signedIn()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Notifications
    match /notifications/{nid} {
      allow read: if signedIn()
        && resource.data.recipientId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['recipientId', 'type'])
        && request.resource.data.actorId == request.auth.uid;

      allow update, delete: if signedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    // Marketplace
    match /listings/{lid} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.price is number
        && request.resource.data.price > 0;
      allow update, delete: if signedIn()
        && resource.data.sellerId == request.auth.uid;
    }

    match /orders/{oid} {
      allow read: if signedIn() && (
        resource.data.buyerId == request.auth.uid
        || resource.data.sellerId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.buyerId == request.auth.uid
        || resource.data.sellerId == request.auth.uid
      );
      allow delete: if false;
    }

    // Groups / events
    match /groups/{gid} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /events/{eid} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    // Blocks / reports
    match /blocks/{bid} {
      allow read: if signedIn()
        && resource.data.blockerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.blockerId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.blockerId == request.auth.uid;
    }

    match /reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
